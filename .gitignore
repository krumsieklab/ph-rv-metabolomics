# Raw data and generated outputs
data/*
outputs/*
metrv_models/*

!data/README.md
!outputs/README.md
!metrv_models/README.md

# Large or sensitive analysis artifacts
*.csv
*.tsv
*.xlsx
*.xls
*.rds
*.Rds
*.RDS
*.rda
*.RData
*.parquet
*.feather
*.sas7bdat
*.dta
*.sav
*.log

# Figures are generated by default; explicitly allow the graphical abstract.
*.png
*.jpg
*.jpeg
*.pdf
*.tif
*.tiff
*.svg
!assets/
!assets/README.md
!assets/graphical_abstract.png
!figures/
!figures/graphical_abstract.png

# Scratch notebooks and notebook caches
notebooks/temp.ipynb
notebooks/.ipynb_checkpoints/
**/.ipynb_checkpoints/

# R session, cache, and build artifacts
.Rhistory
.RData
.Ruserdata
.Renviron
.Rproj.user/
renv/library/
renv/local/
renv/cellar/
renv/lock/
renv/python/
renv/sandbox/
renv/staging/
renv.lock.bak
notebooks/renv/

# Local configuration and secrets
.env
.env.*
!.env.example
secrets/
credentials/
config/*.local.*
config/config.yaml

# Editor/OS noise
.DS_Store
.vscode/
.idea/
.cursorrules
